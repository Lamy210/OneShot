FROM node:18-bullseye-slim AS base
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@8.13.1

# Install dependencies
FROM base AS deps
COPY package.json pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/backend/package.json ./apps/backend/
COPY packages/utils/package.json ./packages/utils/
RUN pnpm install

# Build stage
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build utils first, then backend
RUN pnpm run build --filter=@oneshot/utils
RUN pnpm run build --filter=@oneshot/backend

# Production stage
FROM node:18-bullseye-slim AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN apt-get update && apt-get install -y openssl libssl1.1 && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs backend

COPY --from=builder /app/apps/backend/dist ./dist
COPY --from=builder /app/apps/backend/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules

# Create logs directory with proper permissions
RUN mkdir -p /app/logs && chown -R backend:nodejs /app/logs

USER backend

EXPOSE 3001

ENV PORT=3001

CMD ["node", "dist/src/index.js"]
