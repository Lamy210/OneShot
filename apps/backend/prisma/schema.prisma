// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PostStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'message', 'payment', 'system', 'post', 'payout'
  title     String
  body      String
  link      String?  // 関連画面へのリンク
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  readAt    DateTime?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model User {
  id        String   @id @default(uuid())
  nickname  String   @db.VarChar(32)
  email     String   @unique
  authId    String   @unique // Keycloak User ID
  password  String   // 追加: パスワードハッシュ
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe Connect related fields
  stripeConnectAccountId String? // Stripe Connect Account ID
  stripeOnboardingCompleted Boolean @default(false)
  stripeAccountEnabled Boolean @default(false)
  
  // Bank account information (for display purposes)
  bankName        String? @db.VarChar(100)
  bankBranch      String? @db.VarChar(100)
  accountType     String? @db.VarChar(20) // savings, checking
  accountNumber   String? @db.VarChar(20)
  accountHolder   String? @db.VarChar(100)
  
  // Payout settings
  payoutEnabled   Boolean @default(false)
  minPayoutAmount Int?    @default(1000) // 最小振込金額（円）

  // パスワードリセット用
  passwordResetToken String?   // 追加: リセット用トークン
  passwordResetTokenExpires DateTime? // 追加: トークン有効期限

  // Relations
  posts    Post[]
  reports  Report[]
  payerPayments     Payment[] @relation("PayerPayments")
  recipientPayments Payment[] @relation("RecipientPayments")
  notifications Notification[]
  notificationSettings NotificationSettings? // 通知設定リレーション追加
  postViews    PostView[] @relation("UserViews")
  postLikes    PostLike[] @relation("UserLikes")
  userSessions UserSession[] // ユーザーセッションリレーション追加
  pushSubscriptions PushSubscription[] // プッシュ通知サブスクリプションリレーション追加

  @@map("users")
}

model Post {
  id          String     @id @default(uuid())
  authorId    String
  title       String     @db.VarChar(100)
  categoryId  String     // カテゴリIDを追加
  content     String
  budget      Int // 予算（円）
  deadline    DateTime?
  status      PostStatus @default(OPEN)
  flagsCount  Int        @default(0)
  acceptedBy  String?    // 受注者ID
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  author  User     @relation(fields: [authorId], references: [id])
  category Category @relation(fields: [categoryId], references: [id]) // カテゴリリレーション追加
  flags   Report[]
  payment Payment?
  views   PostView[]
  likes   PostLike[]

  @@map("posts")
}

// カテゴリモデルを追加
model Category {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(50) @unique
  description String?  @db.VarChar(200)
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  posts Post[]

  @@map("categories")
}

model Report {
  id        String       @id @default(uuid())
  postId    String
  reporterId String
  reason    String       @db.VarChar(200)
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  post     Post @relation(fields: [postId], references: [id])
  reporter User @relation(fields: [reporterId], references: [id])

  @@unique([postId, reporterId])
  @@map("reports")
}

model Payment {
  id                String        @id @default(uuid())
  postId           String        @unique
  payerId          String        // 支払者（依頼者）
  recipientId      String?       // 受取者（受注者）
  amount           Int           // 支払い金額（円）
  platformFee      Int           // プラットフォーム手数料（円）
  recipientAmount  Int?          // 受注者への支払い金額（円）
  stripePaymentId  String?       // Stripe Payment Intent ID
  stripeAccountId  String?       // Stripe Connect Account ID（受注者）
  stripeTransferId String?       // Stripe Transfer ID
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?     // エスクロー入金日時
  transferredAt    DateTime?     // 受注者への振込完了日時
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  post      Post   @relation(fields: [postId], references: [id])
  payer     User   @relation("PayerPayments", fields: [payerId], references: [id])
  recipient User?  @relation("RecipientPayments", fields: [recipientId], references: [id])

  @@map("payments")
}

// 閲覧ログテーブルを追加
model PostView {
  id        String   @id @default(uuid())
  postId    String
  viewerId  String?  // ログイン済みユーザーの場合
  ipAddress String?  // IPアドレス（匿名閲覧の場合）
  userAgent String?  // ユーザーエージェント
  viewedAt  DateTime @default(now())

  // Relations
  post  Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewer User? @relation("UserViews", fields: [viewerId], references: [id])

  @@unique([postId, viewerId, ipAddress]) // 同一ユーザー/IPからの重複閲覧を防ぐ
  @@index([postId, viewedAt])
  @@index([viewerId, viewedAt])
  @@map("post_views")
}

// いいねテーブルを追加
model PostLike {
  id       String   @id @default(uuid())
  postId   String
  userId   String
  likedAt  DateTime @default(now())

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("UserLikes", fields: [userId], references: [id])

  @@unique([postId, userId]) // 同一ユーザーの重複いいねを防ぐ
  @@index([postId, likedAt])
  @@index([userId, likedAt])
  @@map("post_likes")
}

// ユーザーセッション管理テーブル
model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  isValid      Boolean  @default(true)
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isValid])
  @@index([refreshToken])
  @@map("user_sessions")
}

// プッシュ通知サブスクリプションテーブル
model PushSubscription {
  id           String   @id @default(uuid())
  userId       String
  endpoint     String   @unique
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([endpoint])
  @@map("push_subscriptions")
}

model NgWord {
  id        String   @id @default(uuid())
  word      String   @unique @db.VarChar(100)
  category  String?  @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ng_words")
}

// メール設定モデル
model EmailConfig {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(200)
  
  // SMTP設定
  host        String   @db.VarChar(255)
  port        Int
  secure      Boolean  @default(false)
  username    String   @db.VarChar(255)
  password    String   @db.VarChar(255)
  fromEmail   String   @db.VarChar(255)
  fromName    String?  @db.VarChar(100)
  
  // 設定
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_configs")
}

// メールテンプレートモデル
model EmailTemplate {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(200)
  
  // テンプレート内容
  subject     String   @db.VarChar(200)
  htmlBody    String   @db.Text
  textBody    String?  @db.Text
  
  // 設定
  isActive    Boolean  @default(true)
  category    String   @db.VarChar(50) // welcome, password_reset, payment_completed, etc.
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}

// 通知設定モデル
model NotificationSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  
  // 通知タイプ別設定
  emailEnabled     Boolean  @default(true)
  pushEnabled      Boolean  @default(true)
  inAppEnabled     Boolean  @default(true)
  
  // 通知タイプ別の有効/無効設定
  paymentNotifications     Boolean  @default(true)
  postNotifications        Boolean  @default(true)
  messageNotifications     Boolean  @default(true)
  systemNotifications      Boolean  @default(true)
  payoutNotifications      Boolean  @default(true)
  
  // メール通知設定
  emailFrequency    String  @default("immediate") // immediate, daily, weekly
  quietHoursStart   String? @db.VarChar(5) // HH:MM形式
  quietHoursEnd     String? @db.VarChar(5) // HH:MM形式
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}
